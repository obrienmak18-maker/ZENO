rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function sameSchool(schoolId) { return signedIn() && request.auth.token.school_id == schoolId; }
    function admin() { return signedIn() && (request.auth.token.role == 'ADMINISTRATEUR' || request.auth.token.role == 'DIRECTEUR' || request.auth.token.role == 'admin' || request.auth.token.role == 'directeur'); }
    function staff() { return signedIn() && request.auth.token.role in ['ADMINISTRATEUR', 'DIRECTEUR', 'PROFESSEUR', 'COMPTABLE', 'SECRETAIRE', 'RESPONSABLE_PEDAGOGIQUE', 'SURVEILLANT', 'admin', 'directeur', 'professeur', 'comptable', 'secretaire']; }
    function validFile() { return request.resource != null && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*|application/pdf|text/csv'); }

    match /ecoles/{schoolId}/photos/{fileName=**} {
      allow read: if sameSchool(schoolId) && staff();
      allow write: if sameSchool(schoolId) && staff() && validFile();
      allow delete: if sameSchool(schoolId) && admin();
    }
    match /ecoles/{schoolId}/documents/{fileName=**} {
      allow read: if sameSchool(schoolId) && staff();
      allow write: if sameSchool(schoolId) && staff() && validFile();
      allow delete: if sameSchool(schoolId) && admin();
    }
    match /ecoles/{schoolId}/bulletins/{fileName=**} {
      allow read: if sameSchool(schoolId) && staff();
      allow write: if sameSchool(schoolId) && (admin() || request.auth.token.role in ['SECRETAIRE', 'secretaire']) && validFile();
      allow delete: if sameSchool(schoolId) && admin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
