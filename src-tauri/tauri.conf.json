{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CLASSE",
  "version": "1.0.0",
  "identifier": "cd.classe.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5173",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [{
      "title": "CLASSE — Gestion scolaire",
      "width": 1440,
      "height": 900,
      "minWidth": 1024,
      "minHeight": 700,
      "resizable": true,
      "fullscreen": false,
      "decorations": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Education",
    "shortDescription": "Gestion scolaire CLASSE",
    "longDescription": "CLASSE centralise les élèves, le personnel, les présences, les notes, les bulletins et la comptabilité de l’établissement.",
    "copyright": "CLASSE"
  }
}
