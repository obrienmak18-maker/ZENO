{
  "name": "classe-school-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tauri:dev": ". \"$HOME/.cargo/env\" && tauri dev",
    "tauri:build": ". \"$HOME/.cargo/env\" && tauri build",
    "tauri:check": ". \"$HOME/.cargo/env\" && cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "firebase": "^12.17.1",
    "lucide-react": "^0.545.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@tauri-apps/cli": "^2.5.0",
    "typescript": "~5.9.3"
  }
}
