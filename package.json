{
  "name": "classe-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test && vitest run packages/shared/src/index.test.ts",
    "test:rules": "firebase emulators:exec --project classe-rules-test --only firestore \"vitest run firebase/tests/firestore.rules.test.ts\"",
    "firebase:build": "pnpm --dir firebase/functions build",
    "firebase:deploy": "firebase deploy --only firestore:rules,functions,hosting",
    "tauri:dev": "pnpm --filter @classe/desktop tauri:dev",
    "tauri:build": "pnpm --filter @classe/desktop tauri:build"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.28.2",
    "turbo": "^2.5.6",
    "vitest": "^4.1.11"
  }
}
